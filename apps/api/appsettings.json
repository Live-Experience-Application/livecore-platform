{
  "ConnectionStrings": {
    "Database": ""
  },
  "Authentication": {
    "Oidc": {
      "Authority": "",
      "Audience": "",
      "RequireHttpsMetadata": true
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "SourceOffer": {
    "RepositoryUrl": "",
    "Modified": false
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "HttpsSecurity": {
    "Hsts": {
      "Enabled": false,
      "MaxAgeDays": 365,
      "IncludeSubDomains": false,
      "Preload": false
    },
    "HttpsRedirection": {
      "Enabled": false,
      "StatusCode": 308,
      "Port": null
    }
  },
  "SecurityHeaders": {
    "Enabled": true,
    "ContentTypeOptions": {
      "Enabled": true,
      "Value": "nosniff"
    },
    "ReferrerPolicy": {
      "Enabled": true,
      "Value": "no-referrer"
    },
    "ContentSecurityPolicy": {
      "Enabled": true,
      "Value": "default-src 'none'; frame-ancestors 'none'"
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Webhooks": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0,
      "MaxRequestBodyBytes": 131072
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
