<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Module-internal implementations (e.g. repositories) stay internal;
         only the test projects may see them. The integration suite additionally needs the internal
         RealtimeConnectionRegistry to use its connection count as a deterministic barrier (the
         CORE-RTC-002 eviction tests must wait until the server has finished admitting a live hub
         connection before triggering its eviction). -->
    <InternalsVisibleTo Include="LiveCore.Api.UnitTests" />
    <InternalsVisibleTo Include="LiveCore.Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- AWS SDK for .NET S3 client (CORE-OPS-006). The official, maintained SDK for the S3 protocol, used by
         S3CompatibleAssetStorage to mint SigV4 pre-signed upload/download URLs (computed locally, no network
         round-trip) and to delete objects against any S3-compatible backend - RustFS self-hosted or any
         S3-compatible provider hosted (docs/02_ARCHITECTURE.md; docs/12_STORAGE_ASSETS.md; ADR 0006). A
         justified new dependency: implementing S3 SigV4 pre-signing by hand would be security-sensitive
         crypto we should not reimplement. Endpoint and credentials are supplied at runtime via configuration
         only (Assets:Storage:*); none live in source (threat T7). -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.305.22" />
    <!-- Official Microsoft package that implements the documented OIDC-first
         request flow (docs/02_ARCHITECTURE.md; docs/adr/0005): JWT bearer token
         validation against the external OIDC provider. Patch-aligned to the other
         Microsoft.* packages here (10.0.9). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <!-- Official ASP.NET Core SignalR backplane over a Redis/Valkey-compatible server (CORE-OPS-007). It
         makes the SignalR HubLifetimeManager that backs IHubContext<SessionHub> publish each group send over
         Redis pub/sub, so a group delivery reaches the connections held by EVERY API instance, not just the
         local one (docs/11_REALTIME_SYNC.md "Scale-out"; docs/02_ARCHITECTURE.md names a Valkey/Redis-compatible
         backplane for realtime scale-out). A justified new dependency: it is the Microsoft-maintained backplane
         the framework documents for SignalR scale-out, and reimplementing cross-instance hub fan-out (group
         membership tracking + pub/sub) by hand would duplicate that subsystem. It is wired ONLY when a backplane
         connection string is configured (Realtime:Backplane:ConnectionString); unconfigured the host stays on the
         in-process default. The connection string is supplied at runtime via configuration only; none lives in
         source (threat T7). Patch-aligned to the other Microsoft.AspNetCore.* packages here (10.0.9). -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <!-- OpenTelemetry metrics (CORE-OBS-001). docs/15_OBSERVABILITY.md mandates eight operational metrics and
         names OpenTelemetry; none existed (no meter, no scrape/OTLP surface). LiveCoreMetrics defines the
         instruments on the vendor-neutral System.Diagnostics.Metrics API, but a process still needs an SDK to
         aggregate those measurements and serve them in a scrapeable format. OpenTelemetry is the CNCF-standard,
         vendor-neutral metrics SDK for .NET; reimplementing metric aggregation and the Prometheus exposition
         format by hand would duplicate a correctness-sensitive subsystem. A justified new dependency.
         OpenTelemetry.Extensions.Hosting is the SDK plus the host integration that starts the MeterProvider;
         OpenTelemetry.Exporter.Prometheus.AspNetCore serves the pull-based /metrics scrape endpoint (its
         prerelease pin is justified below). No telemetry backend, endpoint or credential is read from source;
         the scrape surface carries only low-cardinality aggregates, never content (threat T7). -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <!-- Prerelease justification (CORE-CMP-002; AGENTS.md "no new dependencies without explicit
         justification" applies equally to keeping a -beta in a release build). The Prometheus exporter is
         pinned to 1.16.0-beta.1 - a -beta alongside its stable 1.16.0 OpenTelemetry siblings - and that is
         deliberate, not an oversight: the OpenTelemetry .NET Prometheus exporter has NO stable release. It
         ships on the same 1.16.0 train as the stable SDK but keeps the -beta suffix because the upstream
         OpenTelemetry-to-Prometheus exposition specification is not yet declared stable; the suffix reflects
         that spec's status, not instability of this package (it is the OpenTelemetry-maintained exporter, not
         an unofficial fork). It cannot be swapped for a "stable release" without dropping the Prometheus
         /metrics scrape endpoint docs/15_OBSERVABILITY.md mandates - the only alternative,
         OpenTelemetry.Exporter.Prometheus.HttpListener, is equally prerelease, so there is no stable
         substitute. The supply-chain risk a prerelease would otherwise carry is contained: the exact build is
         pinned and restored in locked mode against the committed packages.lock.json (content hash captured,
         CORE-DEP-003), CI verifies that same locked restore over the whole solution so the closure cannot
         float, and the release images are SBOM- and CVE-scanned before publish. Revisit the pin when a stable
         OpenTelemetry.Exporter.Prometheus.AspNetCore is published. -->
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.16.0-beta.1" />
    <!-- OpenTelemetry distributed tracing export (CORE-OBS-003). docs/15_OBSERVABILITY.md requires the key
         request and realtime flows to be exportable to a configured collector. LiveCoreActivitySource produces
         the spans on the vendor-neutral System.Diagnostics activity API and the OpenTelemetry SDK + host
         integration (OpenTelemetry.Extensions.Hosting, already referenced above for the metrics) samples and
         batches them, but shipping them to a collector needs a wire-protocol exporter. OTLP is OpenTelemetry's
         vendor-neutral export protocol that every major collector ingests (the OpenTelemetry Collector,
         Jaeger, Tempo, vendor backends); reimplementing span batching and the OTLP wire format by hand would
         duplicate a correctness-sensitive subsystem. A justified new dependency. It is wired ONLY when a
         collector endpoint is configured (Tracing:Otlp:Endpoint); unconfigured the host still produces spans
         but ships none, so it never reaches a non-existent collector. The endpoint is supplied at runtime via
         configuration only; none lives in source, and the spans carry only low-cardinality, non-sensitive
         attributes, never content (threat T7). Version-aligned to the OpenTelemetry SDK above (1.16.0). -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
  </ItemGroup>

</Project>
