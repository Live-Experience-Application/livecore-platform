<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Module-internal implementations (e.g. repositories) stay internal;
         only the unit test project may see them. -->
    <InternalsVisibleTo Include="LiveCore.Api.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- AWS SDK for .NET S3 client (CORE-OPS-006). The official, maintained SDK for the S3 protocol, used by
         S3CompatibleAssetStorage to mint SigV4 pre-signed upload/download URLs (computed locally, no network
         round-trip) and to delete objects against any S3-compatible backend - RustFS self-hosted or any
         S3-compatible provider hosted (docs/02_ARCHITECTURE.md; docs/12_STORAGE_ASSETS.md; ADR 0006). A
         justified new dependency: implementing S3 SigV4 pre-signing by hand would be security-sensitive
         crypto we should not reimplement. Endpoint and credentials are supplied at runtime via configuration
         only (Assets:Storage:*); none live in source (threat T7). -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.305.22" />
    <!-- Official Microsoft package that implements the documented OIDC-first
         request flow (docs/02_ARCHITECTURE.md; docs/adr/0005): JWT bearer token
         validation against the external OIDC provider. Patch-aligned to the other
         Microsoft.* packages here (10.0.9). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <!-- Official ASP.NET Core SignalR backplane over a Redis/Valkey-compatible server (CORE-OPS-007). It
         makes the SignalR HubLifetimeManager that backs IHubContext<SessionHub> publish each group send over
         Redis pub/sub, so a group delivery reaches the connections held by EVERY API instance, not just the
         local one (docs/11_REALTIME_SYNC.md "Scale-out"; docs/02_ARCHITECTURE.md names a Valkey/Redis-compatible
         backplane for realtime scale-out). A justified new dependency: it is the Microsoft-maintained backplane
         the framework documents for SignalR scale-out, and reimplementing cross-instance hub fan-out (group
         membership tracking + pub/sub) by hand would duplicate that subsystem. It is wired ONLY when a backplane
         connection string is configured (Realtime:Backplane:ConnectionString); unconfigured the host stays on the
         in-process default. The connection string is supplied at runtime via configuration only; none lives in
         source (threat T7). Patch-aligned to the other Microsoft.AspNetCore.* packages here (10.0.9). -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
  </ItemGroup>

</Project>
