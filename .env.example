# livecore-platform — configuration contract (names only)
#
# CORE-OPS-008: the documented secret-management and configuration contract for
# the API and worker hosts. Copy this file to ".env" and fill in real values for
# your deployment. ".env" is git-ignored; ".env.example" ships NAMES ONLY and must
# NEVER contain a real secret — no secret is ever committed (threat T7 in
# docs/07_SECURITY_THREAT_MODEL.md).
#
# Injection: every value below is supplied at runtime as an environment variable
# (12-factor) or from your platform's secret store (Kubernetes Secret, Railway
# variables, Docker secrets). None live in source. The env-var -> secret-store
# mapping is documented in docs/13_SELF_HOSTING_REQUIREMENTS.md.
#
# Naming: .NET reads the hierarchical key "A:B:C" from the environment variable
# "A__B__C" (double underscore). Indexed lists use a numeric suffix ("...__0").
#
# Markers:
#   [secret]        holds a credential — inject from a secret store, never commit.
#   [prod-required] must be set for a production deployment. The API logs a loud,
#                   named startup error and reports not-ready until it is set, and
#                   refuses to start outright for the OIDC audience foot-gun below.
#   (unmarked)      optional — fails closed (denies/empty) when unset.

# --- Persistence (API + worker) ---
# [secret][prod-required] PostgreSQL connection string (carries the DB password).
# Production connection guidance (CORE-RES-004): size the connection pool in the
# connection string with "Maximum Pool Size=<N>", tuned so all API + worker replicas
# together stay within the database's max_connections (e.g. Maximum Pool Size=40).
# Connection pooling is on by default; do not disable it (Pooling=true).
ConnectionStrings__Database=
# Optional persistence tuning (CORE-RES-004), safe defaults shipped — bounds a stuck
# query so retry cannot amplify it unbounded. Both are TimeSpans.
# Client-side per-command ceiling (EF Core/Npgsql CommandTimeout). Default 00:00:30.
Persistence__CommandTimeout=
# Server-side PostgreSQL statement_timeout, applied on every connection. Default
# 00:00:30; set 00:00:00 to disable the server-side ceiling (the client one remains).
Persistence__StatementTimeout=

# --- Identity / OIDC (API) ---
# [prod-required] OIDC issuer/authority the API validates access tokens against.
Authentication__Oidc__Authority=
# [prod-required] Expected token audience (the "aud" claim). A blank Audience in
# production is REFUSED at startup (CORE-OPS-004): it would disable audience scoping.
Authentication__Oidc__Audience=
# Optional: allow non-HTTPS OIDC metadata for local development only (default true).
Authentication__Oidc__RequireHttpsMetadata=
# Optional OIDC backchannel bounds (CORE-RES-005), short/safe defaults shipped — so a slow
# or unreachable provider fails fast instead of stalling token validation. All TimeSpans.
# Per-request timeout on the discovery/JWKS fetch (default 00:00:30, < the framework's 60s).
Authentication__Oidc__BackchannelTimeout=
# How often the cached OIDC config (discovery + signing keys) refreshes (default 06:00:00).
Authentication__Oidc__AutomaticRefreshInterval=
# Minimum interval between forced config refreshes (default 00:05:00).
Authentication__Oidc__RefreshInterval=

# --- Edge: CORS, forwarded headers, host filtering (API) ---
# Optional: browser/PWA origins allowed to call the API and the SignalR hub
# (fail-closed empty = no cross-origin browser client). Indexed list.
Cors__AllowedOrigins__0=
# Optional: trusted reverse-proxy IPs / CIDR networks for the X-Forwarded-* headers
# (loopback is always trusted; nothing else is, so no client can spoof the scheme).
ForwardedHeaders__KnownProxies__0=
ForwardedHeaders__KnownNetworks__0=
# Optional: raise the trusted-hop count when more than one proxy is in the chain.
ForwardedHeaders__ForwardLimit=
# Optional: public host(s) the API answers to (semicolon-separated; default localhost).
AllowedHosts=
# Optional: app-level HSTS + HTTPS redirection (CORE-SEC-005). BOTH OFF by default: in the
# documented TLS-terminating reverse-proxy posture the proxy owns the redirect/HSTS. Turn these
# ON only when the API terminates TLS itself (no terminating proxy in front). Wired right after
# the forwarded headers above, so behind a trusted proxy the forwarded https scheme means an
# enabled redirect never fires.
# Redirect insecure http -> https (default false). StatusCode default 308 (set 307 for temporary);
# Port pins the target https port (default: resolved from HTTPS_PORT / the server's https address).
HttpsSecurity__HttpsRedirection__Enabled=
HttpsSecurity__HttpsRedirection__StatusCode=
HttpsSecurity__HttpsRedirection__Port=
# Emit Strict-Transport-Security on secure responses (default false). MaxAgeDays default 365 (the
# preload floor); IncludeSubDomains/Preload default false (only set Preload once every subdomain
# is committed to long-lived HTTPS). Loopback hosts are excluded, so local dev is never pinned.
HttpsSecurity__Hsts__Enabled=
HttpsSecurity__Hsts__MaxAgeDays=
HttpsSecurity__Hsts__IncludeSubDomains=
HttpsSecurity__Hsts__Preload=

# --- Baseline HTTP security response headers (API, CORE-SEC-009) ---
# Optional: the API adds X-Content-Type-Options/Referrer-Policy/Content-Security-Policy to every API, error and
# SignalR-negotiate response. ON BY DEFAULT (the API serves only JSON/Problem-Details and renders no HTML, so a
# deny-all CSP is safe). Set Enabled=false to turn the whole feature off, or turn one header off with its own
# *__Enabled=false (which removes exactly that header). Each *__Value overrides the directive (a blank value falls
# back to the default below). All values are static directives — they carry no tenant/principal detail (threat T7).
SecurityHeaders__Enabled=
# X-Content-Type-Options (default value "nosniff" — stop MIME content-sniffing).
SecurityHeaders__ContentTypeOptions__Enabled=
SecurityHeaders__ContentTypeOptions__Value=
# Referrer-Policy (default value "no-referrer" — keep the request URL out of the onward Referer).
SecurityHeaders__ReferrerPolicy__Enabled=
SecurityHeaders__ReferrerPolicy__Value=
# Content-Security-Policy (default value "default-src 'none'; frame-ancestors 'none'" — deny-all; frame-ancestors
# forbids framing and subsumes X-Frame-Options).
SecurityHeaders__ContentSecurityPolicy__Enabled=
SecurityHeaders__ContentSecurityPolicy__Value=

# --- AGPL section 13 source offer (API) ---
# Optional: the Corresponding Source repository the anonymous GET /source endpoint offers
# remote users (CORE-CMP-001). The offered URL is PINNED to the running build version's tag
# (<repository>/tree/v<version>) so it resolves to the EXACT source running, not the repo
# root (CORE-LIC-005). When set it must be an absolute http(s) URL; unset = the canonical
# upstream repository.
SourceOffer__RepositoryUrl=
# Optional: set to true to DECLARE that this deployment runs MODIFIED Core source. A modified
# deployment MUST also set SourceOffer__RepositoryUrl to its own Corresponding Source — AGPL
# section 13 obliges it to offer the source actually running there, not the canonical upstream.
# When Modified=true and SourceOffer__RepositoryUrl is unset the host REFUSES TO START, so a
# modified deployment cannot silently keep offering upstream (CORE-LIC-005). Unset/false = an
# unmodified deployment that offers the canonical upstream source.
SourceOffer__Modified=

# --- Request rate limiting (API) ---
# Optional: rate limiting is ON by default with safe, generous limits (CORE-SEC-001).
# Set Enabled=false to turn it off (for a deployment that throttles at its edge instead).
RateLimiting__Enabled=
# Per-principal GLOBAL limit on authenticated endpoints (fixed window). Defaults: 300 / 60s.
RateLimiting__Global__PermitLimit=
RateLimiting__Global__WindowSeconds=
RateLimiting__Global__QueueLimit=
# Per-IP limit on the anonymous NON-webhook surface (the /hubs/session negotiate and any anonymous
# REST probe), so an unauthenticated flood is bounded too (CORE-SEC-007). Defaults: 300 / 60s. The
# infrastructure endpoints (/health/*, /metrics) are exempt so probes/scrapes stay reachable.
RateLimiting__Anonymous__PermitLimit=
RateLimiting__Anonymous__WindowSeconds=
RateLimiting__Anonymous__QueueLimit=
# Strict PER-IP limit on the anonymous store-notification webhooks (fixed window). Defaults: 60 / 60s.
RateLimiting__Webhooks__PermitLimit=
RateLimiting__Webhooks__WindowSeconds=
RateLimiting__Webhooks__QueueLimit=
# NON-DISABLEABLE per-IP request-rate FLOOR the webhook keeps when Enabled=false, so disabling the
# limiter cannot fully remove webhook volume protection (CORE-SEC-007). Defaults: 600 / 60s. A
# non-positive value falls back to the default (the floor cannot be configured away).
RateLimiting__Webhooks__FloorPermitLimit=
RateLimiting__Webhooks__FloorWindowSeconds=
# Hard request-body-size cap on the webhooks, in bytes (rejected 413 beyond it). Default: 131072.
RateLimiting__Webhooks__MaxRequestBodyBytes=

# --- Host lifecycle: graceful shutdown (API + worker) ---
# Optional: graceful-shutdown drain window (HostOptions.ShutdownTimeout, a TimeSpan) both hosts
# wait for in-flight HTTP/SignalR requests (API) and background job ticks (worker) to drain before
# forcing shutdown, so a rolling restart does not abruptly cut an in-flight request (default 00:00:25).
# Keep it AT OR BELOW the orchestration termination grace period (e.g. Kubernetes
# terminationGracePeriodSeconds, default 30s) so the process exits cleanly before SIGKILL. CORE-DEP-002.
Hosting__ShutdownTimeout=

# --- Object storage (API + worker) ---
# Private, S3-compatible bucket for asset binaries. [prod-required for media]:
# Endpoint plus the two [secret] credentials must ALL be set together for storage
# to be wired; otherwise asset operations fail closed (503) and assets stay private.
Assets__Storage__Endpoint=
Assets__Storage__AccessKeyId=
Assets__Storage__SecretAccessKey=
# Optional storage tuning (safe defaults shipped in appsettings.json).
Assets__Storage__Region=
Assets__Storage__ForcePathStyle=
Assets__Storage__UrlLifetime=
Assets__Storage__Bucket=
Assets__Storage__Provider=
# Optional outbound-call bounds (CORE-RES-005), short/safe defaults shipped — so a hung
# storage backend (real network round-trip is DeleteObjectAsync) fails fast instead of
# blocking up to the AWS SDK 100s default. Per-request Timeout (default 00:00:30, a TimeSpan).
Assets__Storage__RequestTimeout=
# Bounded retry count (default 2) and retry mode (Legacy/Standard/Adaptive, default Standard).
Assets__Storage__MaxErrorRetry=
Assets__Storage__RetryMode=
# Optional upload-acceptance policy (CORE-AST-007), already-hardened defaults shipped — abuse-surface
# hardening INDEPENDENT of the workspace storage quota, enforced fail-closed BEFORE any signed upload URL
# is minted. The MIME allowlist the declared content-type is checked against (indexed list, matched
# case-insensitively). ABSENT = a curated default set (images, application/pdf, audio, video, text/plain);
# an explicitly empty list disables the content-type restriction.
Assets__Upload__AllowedContentTypes__0=
# Absolute per-object size ceiling in bytes the declared sizeBytes is checked against (rejected 413 beyond
# it, inclusive). Default: 1073741824 (1 GiB). Must be strictly positive.
Assets__Upload__MaxObjectSizeBytes=

# --- Realtime scale-out backplane (API) ---
# [secret] Redis/Valkey connection string — REQUIRED only when running more than one
# API instance (HA/scale); unset = single-instance in-process backplane.
Realtime__Backplane__ConnectionString=
# Optional: channel prefix so one Redis/Valkey server can be shared without collisions.
Realtime__Backplane__ChannelPrefix=

# --- Distributed tracing (API) ---
# Optional: OTLP collector endpoint the API exports trace spans to (e.g.
# http://otel-collector:4317). Unset = spans are produced but exported nowhere
# (no collector is contacted). The spans carry only low-cardinality, non-sensitive
# attributes, never content (CORE-OBS-003).
Tracing__Otlp__Endpoint=

# --- Worker (background jobs) ---
# Optional: per-loop liveness heartbeat base file path (default
# <temp>/livecore-worker.heartbeat); each job loop writes its own suffixed file.
Worker__Heartbeat__FilePath=
# Optional: age beyond which a loop's heartbeat reads as hung -> worker not-live
# (default 02:00:00). CORE-DR-003.
Worker__Heartbeat__StaleAfter=
# Optional: the worker's metrics/health HTTP listen URL serving GET /metrics and the
# per-loop GET /health/live (default http://0.0.0.0:9464). CORE-DR-003.
Worker__Metrics__Url=
# Optional: asset cleanup job timings/batch (CORE-AST-006). Defaults:
# PendingRetention=24:00:00, SweepInterval=01:00:00 (1h), BatchSize=100.
# The job runs only when a database is configured.
Assets__Cleanup__PendingRetention=
Assets__Cleanup__SweepInterval=
Assets__Cleanup__BatchSize=
# Optional: recap generation job cadence and batch size (CORE-JOB-001). Defaults:
# SweepInterval=01:00:00 (1h), BatchSize=50. The job runs only when a database is configured.
Recaps__Generation__SweepInterval=
Recaps__Generation__BatchSize=
# Optional: export processing job cadence and batch size (CORE-JOB-002). Defaults:
# SweepInterval=01:00:00 (1h), BatchSize=50. The job runs only when a database is configured.
Exports__Processing__SweepInterval=
Exports__Processing__BatchSize=

# --- Store purchase verification / notifications (API) ---
# [secret] The Apple/Google store server credentials and notification signing keys
# are consumed by the deployment-supplied verification/notification ADAPTER, not read
# from a fixed Core key. Supply them to that adapter via your secret store; with no
# adapter configured, store verification and notifications fail closed (503).

# --- Store notification reconciliation job (worker) ---
# OFF BY DEFAULT and fail-closed: the billing-gated reconciliation loop runs only when
# a deployment has wired store billing and explicitly enables it (CORE-JOB-003).
Store__Reconciliation__Enabled=
# Optional cadence/batch when enabled. Defaults: SweepInterval=01:00:00 (1h), BatchSize=50.
Store__Reconciliation__SweepInterval=
Store__Reconciliation__BatchSize=

# --- Data-retention sweep (worker, CORE-PRIV-003) ---
# Expires and purges terminal/old personal-data-bearing records on configurable, per-family
# windows (GDPR Art.5(1)(e) storage limitation). Runs only when a database is configured.
# Optional global cadence/batch. Defaults: SweepInterval=01:00:00 (1h), BatchSize=100.
Retention__SweepInterval=
Retention__BatchSize=
# Per-family Enabled flag + RetentionWindow (measured from the record's age). The surprising
# deletions are OFF by default; the invitation plaintext-email and idempotency-key purges are ON.
# Sessions (+ their session events, recaps, visibility rules) — OFF, default window 365 days.
Retention__Sessions__Enabled=
Retention__Sessions__RetentionWindow=
# Generated recaps (host content) — OFF, default window 365 days.
Retention__Recaps__Enabled=
Retention__Recaps__RetentionWindow=
# Completed export artifacts (the row + any object-storage blob) — OFF, default window 90 days.
Retention__Exports__Enabled=
Retention__Exports__RetentionWindow=
# Closed/expired/revoked invitations (plaintext email) — ON, default window 30 days.
Retention__Invitations__Enabled=
Retention__Invitations__RetentionWindow=
# Idempotency keys, deleted by age alone past any retry horizon (CORE-PRIV-006) — ON, default
# window 30 days. Bounds the otherwise insert-only idempotency_keys table; logged by count only.
Retention__IdempotencyKeys__Enabled=
Retention__IdempotencyKeys__RetentionWindow=
