# LiveCore Docker Compose overrides (CORE-DEP-001) — names only, no secrets.
#
# Docker Compose automatically reads a `.env` file in THIS directory for
# ${VARIABLE} interpolation in docker-compose.yml. Copy this file to `.env` and
# fill in only what you need to override; every variable has a safe local default
# in the manifest, so the stack runs with `docker compose up` even with no `.env`.
#
# `.env` is git-ignored — NEVER commit a real secret (threat T7). The setting
# names match the documented configuration contract at the repository-root
# .env.example (CORE-OPS-008) and docs/13_SELF_HOSTING_REQUIREMENTS.md.

# --- Bundled PostgreSQL credentials ---
# Used by the `postgres` service. If you change these, also set
# ConnectionStrings__Database below so the api/worker/migrate point at them.
POSTGRES_USER=livecore
POSTGRES_PASSWORD=livecore
POSTGRES_DB=livecore

# --- Published host ports ---
LIVECORE_API_PORT=8080
LIVECORE_WORKER_METRICS_PORT=9464

# --- Environment posture ---
# Development (default) lets the bundled stack come up green with no OIDC/storage.
# Set Production for a real deployment (then the [prod-required] values below are
# enforced: the readiness gate reports not-ready until they are set, CORE-OPS-005,
# and a configured Authority with a blank Audience refuses to start, CORE-OPS-004).
ASPNETCORE_ENVIRONMENT=Development

# --- Persistence (api + worker + migrate) ---
# [secret][prod-required] Override to point at an external database instead of the
# bundled `postgres` service. Production connection guidance (CORE-RES-004): tune the
# Npgsql connection pool here with "Maximum Pool Size=<N>" so all api + worker replicas
# stay within the database's max_connections (the manifest defaults api=40, worker=20).
ConnectionStrings__Database=Host=postgres;Port=5432;Database=livecore;Username=livecore;Password=livecore;Maximum Pool Size=40
# Optional per-command timeout ceilings (CORE-RES-004), safe defaults shipped (TimeSpans).
Persistence__CommandTimeout=
Persistence__StatementTimeout=

# --- Identity / OIDC (api) [prod-required] ---
Authentication__Oidc__Authority=
Authentication__Oidc__Audience=
# Allow non-HTTPS OIDC metadata for a local issuer only (default true).
Authentication__Oidc__RequireHttpsMetadata=

# --- Edge: host filtering, forwarded headers, CORS (api) ---
AllowedHosts=localhost;127.0.0.1
# Trust the Compose/ingress network as a forwarding proxy (CIDR), e.g. 10.0.0.0/8.
ForwardedHeaders__KnownNetworks__0=
# Browser/PWA origin allowed to call the API and the SignalR hub, e.g. https://app.example.com.
Cors__AllowedOrigins__0=

# --- Object storage (api + worker) [secret for media] ---
# All three must be set together to enable assets; otherwise asset ops fail closed (503).
Assets__Storage__Endpoint=
Assets__Storage__AccessKeyId=
Assets__Storage__SecretAccessKey=

# --- Realtime scale-out backplane (api) [secret for multi-instance] ---
Realtime__Backplane__ConnectionString=

# --- Worker metrics/health surface ---
Worker__Metrics__Url=http://0.0.0.0:9464
