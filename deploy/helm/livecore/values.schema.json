{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "LiveCore chart values",
  "description": "Schema for the LiveCore Helm chart values (CORE-DEP-004). Helm validates values against this on template/install.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "registry": { "type": "string" },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "config": {
      "type": "object",
      "description": "Non-secret configuration keys rendered into a ConfigMap.",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "secrets": {
      "type": "object",
      "description": "Secret configuration keys rendered into a Secret. Empty by default; no secret is committed.",
      "properties": {
        "existingSecret": { "type": "string" }
      },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "hookWeight": { "type": "integer" },
        "restartPolicy": { "type": "string", "enum": ["Never", "OnFailure"] },
        "resources": { "type": "object" },
        "image": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" }
          }
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "containerPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "livenessProbe": { "type": "object" },
        "readinessProbe": { "type": "object" },
        "resources": { "type": "object" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "podDisruptionBudget": {
          "type": "object",
          "description": "PodDisruptionBudget for the API (CORE-DEP-012). Rendered only when the API can run more than one pod (replicaCount > 1 or autoscaling.enabled); safe at replicaCount 1.",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "maxUnavailable": { "type": ["integer", "string", "null"] },
            "minAvailable": { "type": ["integer", "string", "null"] }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "type": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "description": "Optional HorizontalPodAutoscaler for the API Deployment (CORE-DEP-011). Disabled by default; enabling it implies the realtime backplane requirement (CORE-DEP-009).",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
        "targetMemoryUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "livenessProbe": { "type": "object" },
        "resources": { "type": "object" },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
        "podDisruptionBudget": {
          "type": "object",
          "description": "PodDisruptionBudget for the worker (CORE-DEP-012). Rendered only when worker.replicaCount > 1; safe at replicaCount 1.",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "maxUnavailable": { "type": ["integer", "string", "null"] },
            "minAvailable": { "type": ["integer", "string", "null"] }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "sessionAffinity": {
          "type": "object",
          "description": "SignalR sticky-session affinity (CORE-DEP-002/CORE-DEP-013). When enabled and api.replicaCount > 1, the annotations are merged onto the rendered Ingress.",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "annotations": { "type": "object" }
          }
        },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      }
    }
  }
}
