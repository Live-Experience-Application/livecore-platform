{
  "name": "livecore-platform",
  "version": "0.5.0",
  "private": true,
  "description": "LiveCore Platform workspace root for TypeScript packages (contracts, sdk-ts, ui-core, design-tokens).",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --recursive run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "images:local": "docker compose -f deploy/compose/docker-compose.yml build migrate api worker",
    "lint": "eslint . --max-warnings 0",
    "test:versions": "pnpm --recursive run build && node --test tests/version-lockstep/version-lockstep.test.mjs"
  },
  "packageManager": "pnpm@10.34.2+sha512.9ae7e3fe477c52bbce1ddc8aa196ff243ed4b48f1ceaa7455820adfa7a48b5f57e817ed2d20e5f3c2c3646dfedba360567693e534572dccd252fb2eb8b7c044c",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0"
  }
}
