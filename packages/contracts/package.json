{
  "name": "@livecore/contracts",
  "version": "0.1.0",
  "description": "Stable, product-neutral TypeScript contract types (DTOs, enums, events) for the LiveCore Core API, consumed by vertical apps.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Live-Experience-Application/livecore-platform.git",
    "directory": "packages/contracts"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "node scripts/generate-openapi.mjs --write",
    "check:openapi": "node scripts/generate-openapi.mjs --check",
    "check:events": "node scripts/event-contract-drift.mjs",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node --test tests/contracts.build.test.mjs tests/contracts.events.test.mjs tests/contracts.pack.test.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3"
  }
}
