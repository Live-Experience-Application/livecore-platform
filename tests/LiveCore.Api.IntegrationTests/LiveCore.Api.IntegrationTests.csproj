<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.9" />
    <!-- Test-only: a real SignalR client so the CORE-RTC-002 eviction tests verify behavior "on the open
         socket" — a live hub connection is opened against the in-memory test server, then a participant
         removal / member role change must tear it down. An official Microsoft ASP.NET Core package (same
         family as the framework), pinned to the host's framework version; it adds no runtime dependency to
         the product. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <!-- Same PostgreSQL provider the API host depends on (apps/api, 10.0.2): lets
         the integration suite run against a real PostgreSQL database in CI,
         applying the real checked-in migrations rather than only the SQLite
         EnsureCreated() schema (CORE-OPS-002). The default local run still uses
         the in-memory SQLite provider and needs no database server. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- Test-only: dynamic skip-with-reason for the provider-gated integration tests
         (CORE-TST-011). xunit v2 (the line this suite pins) has no Assert.Skip - that
         is an xunit v3 API - so a test that needs a real PostgreSQL/Redis provider could
         only short-circuit with an early return, which a default local `dotnet test`
         reports as a silent green PASS, hiding that the provider assertions never ran.
         Xunit.SkippableFact is the standard xunit-ecosystem package for v2 dynamic skip
         ([SkippableFact] + Skip.IfNot), so these tests report as Skipped-with-reason
         locally and still run on the CI integration-postgres leg. It is test-only
         (IsPackable=false) and adds no runtime/product dependency. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bounds test-collection parallelism (xunit.runner.json). When the suite runs
         against PostgreSQL (CORE-OPS-002) each parallel test holds its own throwaway
         database and connection pool; capping parallelism keeps the live connection
         count well under PostgreSQL's default max_connections. On the SQLite default
         this is just an upper bound and a no-op on typical CI hosts. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\apps\api\LiveCore.Api.csproj" />
  </ItemGroup>

</Project>
