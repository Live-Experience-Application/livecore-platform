<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <!-- Architecture/fitness test engine (CORE-ARCH-001). The Core API is a modular monolith whose modules are
         folders/namespaces in a single LiveCore.Api.csproj, so before this story nothing MECHANICALLY stopped one
         module referencing another it must not — the boundaries rested on author discipline. NetArchTest.Rules
         reads the COMPILED LiveCore.Api assembly via Mono.Cecil and inspects real type dependencies INCLUDING
         method-body references (where the bulk of the coupling lives), which a signature-only reflection test
         cannot see, so it can assert the allowed inter-module dependency graph and fail when a module references a
         forbidden one. A justified, TEST-ONLY dependency: it is the purpose-built, widely-used .NET architecture
         test library named in the story, it ships no runtime code into any image or published package (it is
         referenced only by this unit-test project), and it adds no product dependency. It is restored in locked
         mode against the committed packages.lock.json like every other package (CORE-DEP-003). -->
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <!-- Security pin (GHSA-2m69-gcr7-jv3q, CORE-DEP-005): EntityFrameworkCore.Sqlite 10.0.9
         transitively resolves the native SQLitePCLRaw.lib.e_sqlite3 2.1.11, which now carries a
         known high-severity advisory, so a locked-mode restore fails NU1903 (warnings-as-errors).
         The EF Sqlite provider has no newer 10.x patch, so the native binary is pinned directly to
         the patched 3.50.3 (SQLitePCLRaw realigned the native-lib package to the bundled SQLite
         version; the 2.1.x managed P/Invoke layer stays ABI-compatible). Test-only (IsPackable=false):
         the in-memory SQLite test database; no runtime/product dependency and not in any shipped image. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!-- Same PostgreSQL provider the API host depends on (apps/api, 10.0.2), pinned to
         the version the integration suite already uses. It lets a provider-divergent
         unit/repository test run against a real PostgreSQL database in CI (the
         unit-smoke-postgres job, CORE-TST-004), so provider-specific behavior — the
         Npgsql-only xmin optimistic-concurrency token — is exercised at the unit level
         and not only on SQLite. The default local run still uses the in-memory SQLite
         provider and needs no database server. This is a test-only reference; it adds
         no runtime dependency to the product. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\apps\api\LiveCore.Api.csproj" />
  </ItemGroup>

</Project>
